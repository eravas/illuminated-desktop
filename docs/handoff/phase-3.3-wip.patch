+import QtQuick
+import Quickshell
+import Quickshell.Io
+import "artifacts"
+ShellRoot {
+    PanelWindow {
+        implicitWidth: 300; implicitHeight: 250
+        Item {
+            id: surface
+            x: 20; y: 30; width: 200; height: 150
+            property bool vertical: false
+            readonly property var description: ({item: surface, width: width, height: height, ink: "#111111", family: "sans-serif", wash: {axis: vertical ? "y" : "x", level: 0.5, ink: "#ffffff"}})
+            Item {
+                id: nested
+                x: 60; y: 40
+                SplitText { id: label; x: 7; y: 9; width: 40; height: 20; face: surface.description; text: "Wash" }
+            }
+        }
+    }
+    IpcHandler {
+        target: "textFaceTest"
+        function state(): string { return JSON.stringify({x: label.origin.x, y: label.origin.y, right: label.washRight, top: label.washTop, bottom: label.washBottom}); }
+        function move(): void { nested.x += 13; }
+        function resize(): void { surface.width = 240; }
+        function vertical(): void { surface.vertical = true; }
+        function lower(): void { nested.y += 35; }
+    }
+}
