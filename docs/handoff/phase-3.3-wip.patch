diff --git a/tests/runtime/text-face.py b/tests/runtime/text-face.py
new file mode 100644
index 0000000..cea23f0
--- /dev/null
+++ b/tests/runtime/text-face.py
@@ -0,0 +1,40 @@
+"""Shared face coordinates and wash clipping under real QML layout changes."""
+import json, pathlib, shutil, subprocess as sp, tempfile, time
+ROOT = pathlib.Path('/project')
+OUT = ROOT / 'artifacts/development'
+with tempfile.TemporaryDirectory() as directory:
+    cfg = pathlib.Path(directory) / 'qml'
+    shutil.copytree(ROOT / 'quickshell', cfg)
+    shutil.copy(ROOT / 'tests/runtime/text-face.qml', cfg / 'text-face.qml')
+    path = str(cfg / 'text-face.qml')
+    with (OUT / 'text-face.log').open('w') as output:
+        process = sp.Popen(['quickshell', '-p', path], stdout=output, stderr=sp.STDOUT)
+        try:
+            def ipc(method):
+                r = sp.run(['quickshell', 'ipc', '-p', path, 'call', 'textFaceTest', method], capture_output=True, text=True, timeout=5)
+                assert r.returncode == 0, r.stderr
+                return r.stdout
+            def wait(expected):
+                end = time.monotonic() + 8
+                state = None
+                while time.monotonic() < end:
+                    if process.poll() is not None:
+                        raise AssertionError((OUT / 'text-face.log').read_text())
+                    try:
+                        state = json.loads(ipc('state'))
+                        if all(abs(state[k] - value) < .001 for k, value in expected.items()):
+                            return
+                    except (AssertionError, json.JSONDecodeError):
+                        pass
+                    time.sleep(.05)
+                raise AssertionError((expected, state))
+            wait({'x': 67, 'y': 49, 'right': 33})
+            ipc('move'); wait({'x': 80, 'right': 20})
+            ipc('resize'); wait({'x': 80, 'right': 40})
+            ipc('vertical'); wait({'top': 26, 'bottom': 20})
+            ipc('lower'); wait({'y': 84, 'top': 0, 'bottom': 20})
+            problems = [line for line in (OUT / 'text-face.log').read_text().splitlines() if any(word in line for word in ('TypeError', 'ReferenceError', 'Cannot assign', 'Binding loop'))]
+            assert not problems, '\n'.join(problems)
+            print('PASS: shared face maps nested translation, resize and vertical wash clipping under real QML', flush=True)
+        finally:
+            process.terminate(); process.wait(timeout=5)
