    },
    "light": {
      "paper": "#E7D9BE",
      "cardstock": "#E3D4BC",
      "cardstockTonal": "#EBDFCB",
      "sunken": "#DBCCB1",
      "ink": "#26372C",
      "mutedInk": "#4B5D51",
      "disabledInk": "#848978",
      "edge": "#A6967B",
