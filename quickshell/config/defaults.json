    }
  },
  "semantic": {
    "onFill": "#211C15",
    "volume": "#FA86B6",
    "volumeMuted": "#CCA4B3",
    "brightness": "#F5AE39",
    "power": "#FADB2C",
    "battery": "#56D57B",
    "batteryTonal": "#7CE695",
    "bluetooth": "#52B5F4",
    "copper": "#C57951",
    "verdigris": "#75CABB",
