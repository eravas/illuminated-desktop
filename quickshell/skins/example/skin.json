{
  "about": "Example skin: copy to ~/.config/illuminated/skin/ and edit. Overrides and additions only; everything else comes from the default skin.",
  "sheets": {
    "clipWiggle": {
      "file": "rail/clip-wiggle.png",
      "columns": 5
    }
  },
  "images": {
    "tray.stamp": "rail/tray-stamp.png",
    "clip.wiggle": {
      "sheet": "clipWiggle",
      "grid": [
        120,
        120
      ],
      "start": 0,
      "count": 5
    },
    "seal": "../default/devices/seal.png",
    "inkwell": "cards/inkwell.png"
  },
  "elements": {
    "nib": {
      "animations": {
        "hoverIn": {
          "tween": {
            "x": 1.5
          },
          "duration": 140
        },
        "hoverOut": {
          "tween": {},
          "duration": 180
        },
        "press": {
          "tween": {
            "x": -1
          },
          "duration": 60
        },
        "release": {
          "tween": {
            "x": 1.5
          },
          "duration": 90
        }
      }
    },
    "paper": {
      "regions": [
        {
          "id": "writing",
          "frames": {
            "source": "notifications.unread",
            "min": 0,
            "max": 6,
            "images": "writing"
          }
        },
        {
          "id": "tray",
          "rect": [
            8,
            15,
            6,
            6
          ],
          "image": "tray.stamp",
          "triggers": {
            "click": "tray"
          },
          "tag": "Tray",
          "pad": 6
        },
        {
          "id": "clip",
          "rect": [
            -1.31,
            5.53,
            12,
            12
          ],
          "image": "paperclip",
          "triggers": {
            "click": "clipboard"
          },
          "tag": "Clipboard · {{clipboard.count}} {{clipboard.count|plural:entry}}",
          "animations": {
            "hoverIn": {
              "frames": "clip.wiggle",
              "fps": 16,
              "mode": "once"
            }
          }
        }
      ]
    },
    "seal": {
      "units": "px",
      "size": [
        26,
        26
      ],
      "anchor": [
        13,
        13
      ],
      "image": "seal",
      "triggers": {
        "click": "deal:desk"
      },
      "tag": "Desk",
      "animations": {
        "hoverIn": {
          "tween": {
            "rotate": -12,
            "scale": 1.08
          },
          "duration": 160,
          "easing": "outBack"
        },
        "hoverOut": {
          "tween": {},
          "duration": 160
        }
      }
    },
    "quiet": {
      "units": "px",
      "size": [
        30,
        30
      ],
      "anchor": [
        15,
        15
      ],
      "image": "tray.stamp",
      "dither": false,
      "markers": [
        {
          "at": [
            25,
            5
          ],
          "shape": "dot",
          "radius": 4,
          "colour": "#ED4A49",
          "when": {
            "source": "notifications.dnd",
            "truthy": true
          }
        }
      ],
      "triggers": {
        "click": "dnd"
      },
      "tag": "Do not disturb"
    },
    "inkwell-face": {
      "units": "px",
      "size": [
        154,
        215.6
      ],
      "image": "inkwell",
      "shadow": false,
      "dither": true,
      "regions": [
        {
          "id": "cork",
          "rect": [
            57,
            20,
            40,
            40
          ],
          "triggers": {
            "click": "deal:levels"
          },
          "tag": "Levels"
        }
      ]
    }
  },
  "rail": {
    "items": [
      {
        "element": "seal",
        "place": "center"
      },
      {
        "element": "nib"
      },
      {
        "system": "rule"
      },
      {
        "system": "workspaces"
      },
      {
        "system": "rule"
      },
      {
        "element": "vial",
        "hand": "levels"
      },
      {
        "element": "antenna",
        "hand": "connections"
      },
      {
        "element": "converter",
        "hand": "battery"
      },
      {
        "element": "matchbox",
        "hand": "power"
      },
      {
        "system": "hands"
      },
      {
        "system": "spacer"
      },
      {
        "system": "media"
      },
      {
        "system": "rule"
      },
      {
        "system": "clock"
      },
      {
        "foot": "paper"
      }
    ]
  },
  "dock": {
    "after": [
      "quiet"
    ]
  },
  "cards": {
    "inkwell": {
      "title": "Ink",
      "face": "inkwell-face",
      "value": "{{volume|percent}}",
      "orientation": "portrait"
    }
  },
  "hands": {
    "desk": {
      "label": "Desk",
      "cards": [
        "skin:inkwell",
        "volume"
      ]
    }
  }
}
