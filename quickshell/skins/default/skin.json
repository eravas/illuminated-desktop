  "elements": {
    "tray": {
      "units": "px",
      "size": [
        24,
        24
      ],
      "anchor": [
        12,
        12
      ],
      "image": "tray.light",
      "states": [
        {
          "when": {
            "source": "mode",
            "eq": "dark"
          },
          "image": "tray.dark"
        }
      ],
      "dither": false,
      "shadow": false,
      "hit": {
        "rect": [
          -8,
          -4,
          40,
          32
        ]
      },
      "triggers": {
        "click": "tray"
      },
      "tag": "Tray"
    },
    "nib": {
      "size": [
        17,
        10
      ],
      "anchor": [
        16,
        5
      ],
      "image": "nib",
      "triggers": {
        "click": "launcher"
      },
      "tag": "Launcher"
    },
    "vial": {
      "size": [
        17,
        9
      ],
      "anchor": [
        16,
        4.5
      ],
      "image": "vial",
      "ink": {
        "mask": "vial.ink",
        "from": [
          8,
          8.1
        ],
        "to": [
          8,
          0.8999999999999999
        ],
        "source": "volume"
      },
      "triggers": {
        "click": "deal:levels",
        "scrollUp": "volume:+5",
        "scrollDown": "volume:-5",
        "middleClick": "mute"
      }
    },
    "antenna": {
      "size": [
        17,
        12
      ],
      "anchor": [
        16,
        6
      ],
      "frames": {
        "source": "network.stage",
        "min": 0,
        "max": 4,
        "images": "antenna.light"
      },
      "states": [
        {
          "when": {
            "all": [
              {
                "source": "mode",
                "eq": "dark"
              },
              {
                "source": "network.connecting",
                "truthy": true
              },
              {
                "source": "network.stage",
                "eq": 0
              }
            ]
          },
          "image": "antenna.dark.connecting"
        },
        {
          "when": {
            "all": [
              {
                "source": "network.connecting",
                "truthy": true
              },
              {
                "source": "network.stage",
                "eq": 0
              }
            ]
          },
          "image": "antenna.light.connecting"
        },
        {
          "when": {
            "source": "mode",
            "eq": "dark"
          },
          "frames": {
            "source": "network.stage",
            "min": 0,
            "max": 4,
            "images": "antenna.dark"
          }
        }
      ],
      "triggers": {
        "click": "deal:connections"
      }
    },
    "converter": {
      "size": [
        17,
        28
      ],
      "anchor": [
        16,
        14
      ],
      "image": "converter",
      "visibleWhen": {
        "source": "battery.present",
        "truthy": true
      },
      "ink": {
        "mask": "converter.ink",
        "from": [
          12.37,
          5.46
        ],
        "to": [
          1.66,
          19.17
        ],
        "source": "battery.level",
        "bands": {
          "source": "battery.state",
          "eq": "chg"
        }
      },
      "markers": [
        {
          "at": [
            14.34,
            2.94
          ],
          "shape": "dot",
          "when": {
            "source": "battery.state",
            "eq": "held"
          }
        }
      ],
      "triggers": {
        "click": "deal:battery"
      }
    },
    "matchbox": {
      "size": [
        17,
        13
      ],
      "anchor": [
        16,
        6.5
      ],
      "image": "matchbox",
      "triggers": {
        "click": "deal:power"
      }
    },
    "paper": {
      "size": [
        18,
        22
      ],
      "anchor": [
        0,
        22
      ],
      "image": "paper",
      "triggers": {
        "click": "notifications"
      },
      "regions": [
        {
          "id": "writing",
          "frames": {
            "source": "notifications.unread",
            "min": 0,
            "max": 6,
            "images": "writing"
          }
        },
        {
          "id": "clip",
          "rect": [
            -1.31,
            5.53,
            12,
            12
          ],
          "image": "paperclip",
          "triggers": {
            "click": "clipboard"
          },
          "tag": "Clipboard history"
        }
      ]
    }
  },
